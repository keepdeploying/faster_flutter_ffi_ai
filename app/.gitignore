# All target platforms, so the repository holds only the Dart code.
# `flutter create .` generates them again in seconds, with no download
android/
ios/
web/
windows/
linux/
macos/
.metadata

# Ignored, like the platform folders, because `flutter create .` rewrites it
# (Flutter 3.47.6 changed two package versions in it). A committed lockfile
# would leave every attendee with a changed file, and `git checkout step-NN`
# refuses to run over local changes.
pubspec.lock
